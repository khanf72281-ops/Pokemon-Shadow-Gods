[app]
title = Pokemon Shadow Gods
package.name = shadowgods
package.domain = org.bharat.pokemon
source.dir = .
source.include_exts = py,png,jpg,kv,atlas,json,wav,mp3
version = 1.0
requirements = python3,pygame
orientation = landscape
fullscreen = 1
android.archs = armeabi-v7a, arm64-v8a
android.api = 31
android.minapi = 21
android.accept_sdk_license = True

[buildozer]
log_level = 2
warn_on_root = 1
